ios/**/*.xcuserstate
ios/**/xcuserdata/
ios/**/.swiftpm/
ios/**/*.xcworkspace/xcuserdata/
ios/**/*.xcodeproj/xcuserdata/
ios/**/*.xcodeproj/project.xcworkspace/xcuserdata/

# Swift Package Manager
ios/**/.build/

# Deno / pipeline
pipeline/node_modules/

# Supabase local dev
supabase/.branches
supabase/.temp
